{
  "name": "eleventy-new-post",
  "version": "0.0.21",
  "description": "Generates a new Eleventy site post (with options)",
  "author": "John M. Wargo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/johnwargo/eleventy-new-post"
  },
  "type": "module",
  "main": "eleventy-new-post.js",
  "bin": {
    "11ty-np": "eleventy-new-post.js"
  },
  "keywords": [
    "node",
    "eleventy"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc",
    "dev1": "tsc && node eleventy-new-post.js -d",
    "dev2": "tsc && node eleventy-new-post.js -d -p",
    "update": "tsc && node eleventy-new-post.js -u",
    "start": "tsc && node eleventy-new-post.js"
  },
  "dependencies": {
    "boxen": "^8.0.1",
    "cli-logger": "^0.5.40",
    "execa": "^10.0.1",
    "fs-extra": "^11.4.0",
    "prompts": "^2.4.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.2.0",
    "@types/prompts": "^2.4.9",
    "typescript": "^7.0.2"
  }
}
